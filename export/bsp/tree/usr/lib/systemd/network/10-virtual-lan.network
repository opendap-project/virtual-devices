# Virtual T1 LAN NIC (socket_vmnet on the host, MAC set by odap-vdev): stands for the T1's Wi-Fi.
# DHCP from the LAN, the default route, and mDNS so hosts resolve the device by name.
[Match]
MACAddress=52:54:00:0d:a1:01

[Network]
DHCP=yes
MulticastDNS=yes

[DHCPv4]
RouteMetric=100

[IPv6AcceptRA]
RouteMetric=100
