// The simulator window: the virtual device's display, framed by the device (schematic until the
// case exports its geometry), and a sidebar of hardware actions that folds away.

import { Slider } from "std-widgets.slint";

export struct Key {
    role: string,
    // Where the key is in the drawn front, in logical px, to press it there.
    x: length,
    y: length,
    w: length,
    h: length,
    pressed: bool,
    // A key of the case, drawn alone under the front: where it sits, and how far (signed) it
    // slides towards the case when pressed. Without one (a faceplate's own control), pressing
    // darkens it in place.
    sprite: image,
    has-sprite: bool,
    sx: length,
    sy: length,
    sw: length,
    sh: length,
    travel: length,
}

export global Palette {
    in property <color> body: #1d2125;
    in property <color> bezel: #0b0c0e;
    in property <color> action: #ff6a2a;
    in property <color> key: #aab0b6;
    out property <color> page: #111315;
    out property <color> panel: #181b1e;
    out property <color> line: #2a2e33;
    out property <color> text: #f5f6f4;
    out property <color> muted: #9aa0a6;
}

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    Text { text: root.title; color: Palette.muted; font-size: 11px; font-weight: 600; }
    @children
}

// A control of the device in the sidebar: pressed while the mouse button is down, so long
// presses and combinations work as on the hardware.
component Pill inherits Rectangle {
    in property <string> glyph;
    in property <image> icon;
    in property <string> label;
    // A second line: how the hardware does it (a combination), and what holding it does.
    in property <string> detail;
    in property <bool> accent;
    callback down();
    callback up();
    height: root.detail == "" ? 34px : 44px;
    min-width: 0;
    border-radius: root.detail == "" ? 17px : 12px;
    background: touch.pressed ? (root.accent ? Palette.action : Palette.line.brighter(50%)) : (touch.has-hover ? Palette.line.brighter(22%) : Palette.line);
    border-width: 1px;
    border-color: root.accent ? Palette.action.with-alpha(0.7) : #ffffff10;
    // The icon in a square slot at the left, as far from the left edge as from the top and the
    // bottom; the label at the left of the space that remains.
    property <length> slot: root.height;
    // Optical correction: a mark whose weight sits left of its box (a dot in a round end, the
    // power glyph's open top) is moved right until it reads centred in the slot.
    in property <length> nudge;
    HorizontalLayout {
        Rectangle {
            width: root.slot;
            if root.glyph != "": Text { x: root.nudge; width: parent.width; text: root.glyph; color: root.accent && !touch.pressed ? Palette.action : Palette.text; font-size: 14px; vertical-alignment: center; horizontal-alignment: center; }
            if root.icon.width > 0: Image { x: (parent.width - self.width) / 2 + root.nudge; source: root.icon; colorize: Palette.text; width: 15px; height: 15px; }
        }
        // The label at the left, just past the icon's slot, with a small gap. Optical correction:
        // the font's line box puts a lone label 1 px above centre (measured), so it moves down.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            padding-left: 2px;
            padding-top: root.detail == "" ? 2px : 1px;
            padding-right: 12px;
            Text { text: root.label; color: Palette.text; font-size: 12px; overflow: elide; horizontal-alignment: left; }
            if root.detail != "": Text { text: root.detail; color: Palette.muted; font-size: 10px; overflow: elide; horizontal-alignment: left; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.down(); }
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { root.up(); }
        }
    }
}

// A switch with its label: a state of the hardware (a card in, a charger on). The hardware owns
// it: `state` is 0 off, 1 attaching, 2 on, 3 detaching. A click asks for the other side; while
// the change is in flight the knob already stands where it goes, the track and the icon pulse and
// the switch takes no click, until the hardware has it. A switch that cannot take a change now is
// dimmed. The state is shown, never written beside it; the words are for screen readers.
component Toggle inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <int> state;
    // Off when the hardware cannot take the change now (`why` says so).
    in property <bool> enabled: true;
    in property <string> why;
    in property <string> attaching: "Attaching…";
    in property <string> detaching: "Detaching…";
    callback toggled(bool);
    property <bool> on: root.state == 1 || root.state == 2;
    property <bool> busy: root.state == 1 || root.state == 3;
    property <bool> live: root.enabled && !root.busy;
    property <string> detail: root.busy ? (root.state == 1 ? root.attaching : root.detaching) : (root.enabled ? "" : root.why);
    property <bool> beat: mod(animation-tick(), 1200ms) < 600ms;
    height: 28px;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-enabled: root.live;
    accessible-description: root.detail;
    accessible-action-default => { if root.live { root.toggled(!root.on); } }
    HorizontalLayout {
        spacing: 8px;
        Image {
            source: root.icon;
            colorize: root.busy ? (root.beat ? #3b82c4 : Palette.muted) : (root.on ? Palette.text : Palette.muted);
            animate colorize { duration: 600ms; easing: ease-in-out; }
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
        }
        Text { text: root.label; color: Palette.text; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Rectangle {
            width: 34px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: root.on ? #3b82c4 : Palette.line;
            animate background { duration: 120ms; }
            // In flight: a slow pulse over the track, so it reads as waiting, not as broken.
            Rectangle {
                border-radius: parent.border-radius;
                background: Palette.text;
                opacity: root.busy ? (root.beat ? 0.22 : 0.04) : 0;
                animate opacity { duration: 600ms; easing: ease-in-out; }
            }
            Rectangle {
                width: 14px;
                height: 14px;
                y: 2px;
                x: root.on ? parent.width - self.width - 2px : 2px;
                border-radius: 7px;
                background: Palette.text;
                animate x { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
            }
        }
    }
    hover := TouchArea {
        enabled: root.live;
        mouse-cursor: root.live ? pointer : default;
        clicked => { root.toggled(!root.on); }
    }
    background: hover.has-hover && root.live ? #ffffff08 : transparent;
    border-radius: 6px;
}

// A system action: an icon button, its label below it, outside the button, so a longer label
// never crowds the icon.
// `busy`: its action is in flight, shown by its icon (turning, with `spin`, or pulsing) on a
// pulsing ground, its label unchanged (`busy-label` is for screen readers); `enabled`: it can take one.
component Tool inherits VerticalLayout {
    in property <image> icon;
    in property <string> label;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <bool> busy;
    in property <string> busy-label;
    in property <bool> spin;
    callback clicked();
    property <bool> live: root.enabled && !root.busy;
    spacing: 4px;
    Rectangle {
        height: 40px;
        border-radius: 8px;
        opacity: root.live || root.busy ? 1 : 0.4;
        background: root.busy ? Palette.line.brighter(mod(animation-tick(), 1200ms) < 600ms ? 40% : 10%) : (touch.pressed ? Palette.line.brighter(50%) : (touch.has-hover && root.live ? Palette.line.brighter(22%) : Palette.line));
        animate background { duration: 600ms; easing: ease-in-out; }
        accessible-role: button;
        accessible-label: root.label;
        accessible-enabled: root.live;
        accessible-description: root.busy ? root.busy-label : "";
        accessible-action-default => { if root.live { root.clicked(); } }
        Image {
            source: root.icon;
            rotation-angle: root.busy && root.spin ? -360deg * mod(animation-tick(), 1000ms) / 1000ms : 0deg;
            rotation-origin-x: self.width / 2;
            rotation-origin-y: self.height / 2;
            opacity: root.busy && !root.spin ? (mod(animation-tick(), 1200ms) < 600ms ? 1 : 0.35) : 1;
            animate opacity { duration: 600ms; easing: ease-in-out; }
            colorize: root.danger ? #e5484d : Palette.text;
            width: 18px;
            height: 18px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        touch := TouchArea { enabled: root.live; mouse-cursor: root.live ? pointer : default; clicked => { root.clicked(); } }
    }
    Text {
        text: root.label;
        color: root.danger && root.live ? #e5484d : Palette.muted;
        font-size: 10px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

// A key as printed on a keyboard.
component Keycap inherits Rectangle {
    in property <string> text;
    height: 20px;
    min-width: 22px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #ffffff22;
    background: Palette.line;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text { text: root.text; color: Palette.text; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
    }
}

// One binding: its keys, and what they do.
component Binding inherits HorizontalLayout {
    in property <[string]> keys;
    in property <string> does;
    spacing: 4px;
    height: 24px;
    for k in root.keys: Keycap { text: k; y: (parent.height - self.height) / 2; }
    Text { text: root.does; color: Palette.muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
}

// A square icon button of the sidebar's header.
component HeaderButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: touch.has-hover ? Palette.line : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Image {
        source: root.icon;
        colorize: touch.has-hover ? Palette.text : Palette.muted;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component View inherits Window {
    in property <string> name;
    in property <image> screen;
    in property <length> screen-w;
    in property <length> screen-h;
    // The frame, in logical px (panel pixels): the body, and where the display sits in it.
    in property <bool> framed: true;
    // The front of the device, drawn once from the case and faceplate layers (frame.rs), and
    // where the display and the status LED's window are in it.
    in property <image> front;
    in property <length> front-w;
    in property <length> front-h;
    in property <length> screen-x;
    in property <length> screen-y;
    in property <length> led-x;
    in property <length> led-y;
    in property <length> led-d;
    in-out property <[Key]> keys;
    // The status LED's colour, transparent while off (the virtual board's LED adapter drives it).
    in property <color> led: transparent;
    in-out property <bool> sidebar: true;
    // The keyboard bindings, in a modal.
    in-out property <bool> keymap;
    // Under the title: what the device is doing. At the bottom: the last thing worth saying (a
    // saved file, an error), for a few seconds.
    in property <string> status;
    in property <string> note;
    // The hardware's state, from the worker (src/device.rs): switch states are 0 off,
    // 1 attaching, 2 on, 3 detaching.
    in-out property <float> battery: 50;
    in property <bool> battery-known;
    in property <bool> battery-busy;
    in-out property <bool> battery-dragging;
    in property <int> charger;
    in property <int> sd;
    in property <int> usb-disk;
    in property <int> usb-dac;
    // The device as a whole: 0 off, 1 starting, 2 ready, 3 rebooting, 4 stopping.
    in property <int> phase;
    in property <bool> debug-reboot;
    in property <bool> saving;

    callback screen-pointer(string, length, length);
    callback key(string, bool);
    callback combo(bool);
    callback action(string);
    callback battery-set(float);
    callback attach(string, bool);
    callback host-key(string, bool);

    title: root.name;
    background: Palette.page;

    // The host keyboard drives the whole window, mouse or not. Plain keys are the device's
    // controls and are held as long as the key is (the faceplate's host keys: Space, ↑, ↓, P, and ← → as ↑ ↓;
    // S holds Main + Vol −). With ⌘ they are the sidebar's actions, under the same rules as a
    // click: nothing in flight is asked twice, nothing disabled is taken. A key the OS repeats
    // while held is one press, as on the hardware.
    forward-focus: keys-in;
    keys-in := FocusScope {
        key-pressed(e) => {
            if e.repeat { return accept; }
            if (e.modifiers.control || e.modifiers.meta) && (e.text == "k" || e.text == "K" || e.text == "/") { root.keymap = !root.keymap; return accept; }
            // The modal leaves the rest inert: Esc, ⌘K, its X or a click outside closes it.
            if root.keymap {
                return accept;
            }
            if e.modifiers.control || e.modifiers.meta {
                if e.text == "s" || e.text == "S" { root.action("screenshot"); }
                else if (e.text == "r" || e.text == "R") && root.phase == 2 { root.action(e.modifiers.shift ? "reboot-debug" : "reboot"); }
                else if (e.text == "p" || e.text == "P") && e.modifiers.shift && root.phase == 2 { root.action("poweroff"); }
                else if e.text == "1" { root.attach("microsd", root.sd == 0); }
                else if e.text == "2" { root.attach("usb-storage", root.usb-disk == 0); }
                else if e.text == "3" { root.attach("usb-audio", root.usb-dac == 0); }
                else if e.text == "4" && root.battery-known { root.attach("charger", root.charger == 0); }
                else if (e.text == "-" || e.text == "[") && root.battery-known && !root.battery-busy { root.battery = max(0, round(root.battery) - 5); root.battery-set(root.battery); }
                else if (e.text == "=" || e.text == "+" || e.text == "]") && root.battery-known && !root.battery-busy { root.battery = min(100, round(root.battery) + 5); root.battery-set(root.battery); }
                else if e.text == "\\" { root.sidebar = !root.sidebar; }
                else { return reject; }
                return accept;
            }
            if e.text == "s" { root.combo(true); return accept; }
            root.host-key(e.text, true);
            accept
        }
        key-released(e) => {
            // Esc closes on its release: macOS hands the window only the release of Esc.
            if root.keymap {
                if e.text == Key.Escape { root.keymap = false; }
                return accept;
            }
            if e.modifiers.control || e.modifiers.meta { return accept; }
            if e.text == "s" { root.combo(false); return accept; }
            root.host-key(e.text, false);
            accept
        }
    }

    HorizontalLayout {
        padding: 16px;
        spacing: 16px;

        // The device: its drawn front, the live display in it, the keys to press, the LED.
        Rectangle {
            width: root.framed ? root.front-w : root.screen-w;
            height: root.framed ? root.front-h : root.screen-h;
            // The case's keys, under the front: pressed, a key slides sideways into the case, as
            // on the hardware, and the body covers what goes in.
            if root.framed: Rectangle {
                for k in root.keys: Image {
                    visible: k.has-sprite;
                    x: k.sx + (k.pressed ? k.travel : 0);
                    y: k.sy;
                    width: k.sw;
                    height: k.sh;
                    source: k.sprite;
                    animate x { duration: 40ms; easing: ease-out; }
                }
            }
            if root.framed: Image {
                x: 0;
                y: 0;
                width: root.front-w;
                height: root.front-h;
                source: root.front;
            }
            if root.framed: Rectangle {
                for k in root.keys: Rectangle {
                    x: k.x;
                    y: k.y;
                    width: k.w;
                    height: k.h;
                    border-radius: 3px;
                    // A case key moves when pressed (above); a faceplate control darkens in place.
                    // Hovered: a faint light on it.
                    background: k.pressed && !k.has-sprite ? #00000070 : (key-touch.has-hover ? #ffffff18 : transparent);
                    key-touch := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down { root.key(k.role, true); }
                            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { root.key(k.role, false); }
                        }
                    }
                }
            }
            if root.framed && root.led != transparent: Rectangle {
                x: root.led-x - root.led-d / 2;
                y: root.led-y - root.led-d / 2;
                width: root.led-d;
                height: root.led-d;
                border-radius: self.width / 2;
                background: root.led;
                drop-shadow-blur: 10px;
                drop-shadow-color: root.led;
            }
            // The display: the guest's frame, 1:1 in panel pixels; the pointer is a finger.
            Image {
                x: root.framed ? root.screen-x : 0;
                y: root.framed ? root.screen-y : 0;
                width: root.screen-w;
                height: root.screen-h;
                source: root.screen;
                image-rendering: pixelated;
                TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down { root.screen-pointer("down", self.mouse-x, self.mouse-y); }
                        if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { root.screen-pointer("up", self.mouse-x, self.mouse-y); }
                        if e.kind == PointerEventKind.move { root.screen-pointer("move", self.mouse-x, self.mouse-y); }
                    }
                }
            }
        }

        // The layout gives the sidebar its column; inside it, the panel is the whole column when
        // open, and only its button when folded.
        Rectangle {
          width: root.sidebar ? 236px : 36px;
          Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.sidebar ? parent.height : 36px;
            background: Palette.panel;
            border-radius: root.sidebar ? 10px : 8px;
            fold := Rectangle {
                x: parent.width - self.width - (root.sidebar ? 8px : 0);
                y: root.sidebar ? 8px : 0;
                width: 36px;
                height: 36px;
                border-radius: 8px;
                background: grip.has-hover ? Palette.line : transparent;
                accessible-role: button;
                accessible-label: root.sidebar ? "Fold the sidebar" : "Open the sidebar";
                accessible-action-default => { root.sidebar = !root.sidebar; }
                Image {
                    source: root.sidebar ? @image-url("icons/minimize.svg") : @image-url("icons/maximize.svg");
                    colorize: grip.has-hover ? Palette.text : Palette.muted;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                grip := TouchArea { mouse-cursor: pointer; clicked => { root.sidebar = !root.sidebar; } }
            }
            if root.sidebar && root.note != "": Text {
                x: 12px;
                y: parent.height - self.height - 12px;
                width: parent.width - 24px;
                text: root.note;
                color: Palette.muted;
                font-size: 11px;
                wrap: no-wrap;
                overflow: elide;
                accessible-role: text;
            }
            if root.sidebar: HeaderButton {
                x: fold.x - self.width - 2px;
                y: 8px;
                icon: @image-url("icons/keyboard.svg");
                label: "Keyboard bindings";
                clicked => { root.keymap = true; }
            }
            if root.sidebar: VerticalLayout {
                x: 0;
                width: parent.width;
                padding: 12px;
                spacing: 16px;
                alignment: start;

                VerticalLayout {
                    spacing: 2px;
                    // Clear of the keyboard and fold buttons at the top right.
                    padding-right: 74px;
                    Text { text: root.name; color: Palette.text; font-size: 14px; font-weight: 600; }
                    // One line, always: a note never moves the sidebar.
                    Text { text: root.status; color: Palette.muted; font-size: 11px; wrap: no-wrap; overflow: elide; }
                }

                Section {
                    title: "CONTROLS · hold to hold";
                    GridLayout {
                        spacing: 6px;
                        width: parent.width;
                        Row {
                            Pill { glyph: "●"; nudge: 2px; label: "Action"; accent: true; down => { root.key("action", true); } up => { root.key("action", false); } }
                            Pill { icon: @image-url("icons/power.svg"); nudge: 2px; label: "Main"; down => { root.key("main", true); } up => { root.key("main", false); } }
                        }
                        Row {
                            Pill { glyph: "+"; label: "Volume"; down => { root.key("volume-up", true); } up => { root.key("volume-up", false); } }
                            Pill { glyph: "−"; label: "Volume"; down => { root.key("volume-down", true); } up => { root.key("volume-down", false); } }
                        }
                        Row {
                            Pill { colspan: 2; icon: @image-url("icons/screenshot.svg"); label: "Screenshot"; detail: "Main + Vol − · hold: power menu"; down => { root.combo(true); } up => { root.combo(false); } }
                        }
                    }
                }

                Section {
                    title: "POWER";
                    HorizontalLayout {
                        spacing: 8px;
                        Image { source: @image-url("icons/battery.svg"); colorize: Palette.text; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
                        Text { text: round(root.battery) + " %"; color: Palette.text; font-size: 12px; vertical-alignment: center; min-width: 34px; }
                        Slider {
                            minimum: 0;
                            maximum: 100;
                            enabled: root.battery-known && !root.battery-busy;
                            value <=> root.battery;
                            changed => { root.battery-dragging = true; }
                            released => { root.battery-dragging = false; root.battery-set(root.battery); keys-in.focus(); }
                        }
                    }
                    // The battery and charger are the board's battery model, on the device: they
                    // take changes once it runs.
                    Toggle {
                        icon: @image-url("icons/battery-charging.svg");
                        label: "Charger on USB-C";
                        state: root.charger;
                        enabled: root.battery-known;
                        why: "Once the device runs";
                        attaching: "Connecting…";
                        detaching: "Disconnecting…";
                        toggled(on) => { root.attach("charger", on); }
                    }
                }

                Section {
                    title: "STORAGE";
                    // The hardware takes these at any time, booting or not, as a real socket does.
                    Toggle { icon: @image-url("icons/microsd.svg"); label: "microSD card"; state: root.sd; attaching: "Inserting…"; detaching: "Ejecting…"; toggled(on) => { root.attach("microsd", on); } }
                    Toggle { icon: @image-url("icons/usb.svg"); label: "USB disk"; state: root.usb-disk; attaching: "Plugging in…"; detaching: "Unplugging…"; toggled(on) => { root.attach("usb-storage", on); } }
                    Toggle { icon: @image-url("icons/dac.svg"); label: "USB DAC"; state: root.usb-dac; attaching: "Plugging in…"; detaching: "Unplugging…"; toggled(on) => { root.attach("usb-audio", on); } }
                }

                Section {
                    title: "SYSTEM";
                    HorizontalLayout {
                        spacing: 6px;
                        // Restarts and power-off take a ready device, once: the one in flight
                        // shows it, the others wait for it.
                        Tool { icon: @image-url("icons/screenshot.svg"); label: "Save PNG"; busy: root.saving; busy-label: "Saving…"; width: (parent.width - 18px) / 4; clicked => { root.action("screenshot"); } }
                        Tool { icon: @image-url("icons/restart.svg"); label: "Reboot"; enabled: root.phase == 2; busy: root.phase == 3 && !root.debug-reboot; busy-label: "Restarting…"; spin: true; width: (parent.width - 18px) / 4; clicked => { root.action("reboot"); } }
                        Tool { icon: @image-url("icons/developer.svg"); label: "Debug"; enabled: root.phase == 2; busy: root.phase == 3 && root.debug-reboot; busy-label: "Restarting…"; width: (parent.width - 18px) / 4; clicked => { root.action("reboot-debug"); } }
                        Tool { icon: @image-url("icons/power.svg"); label: "Power off"; enabled: root.phase == 2; busy: root.phase == 4; busy-label: "Powering off…"; width: (parent.width - 18px) / 4; danger: true; clicked => { root.action("poweroff"); } }
                    }
                }
            }
        }
        }
    }

    // The keyboard bindings. Closed by its X, a click outside it, or Esc.
    if root.keymap: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000a0;
        TouchArea { clicked => { root.keymap = false; keys-in.focus(); } }
        Rectangle {
            width: min(root.width - 32px, 560px);
            height: min(root.height - 32px, body.preferred-height);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.panel;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.line;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            accessible-role: groupbox;
            accessible-label: "Keyboard bindings";
            // Clicks inside the dialog stay in it.
            TouchArea { }
            body := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: "Keyboard"; color: Palette.text; font-size: 14px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                    HeaderButton { icon: @image-url("icons/x.svg"); label: "Close"; clicked => { root.keymap = false; keys-in.focus(); } }
                }
                HorizontalLayout {
                    spacing: 24px;
                    alignment: start;
                    Section {
                        title: "DEVICE · held as long as the key";
                        horizontal-stretch: 1;
                        alignment: start;
                        Binding { keys: ["Space"]; does: "Action"; }
                        Binding { keys: ["P"]; does: "Main"; }
                        Binding { keys: ["←", "↑"]; does: "Volume + (either)"; }
                        Binding { keys: ["→", "↓"]; does: "Volume − (either)"; }
                        Binding { keys: ["S"]; does: "Screenshot (Main + Vol −)"; }
                        Binding { keys: ["P", "↓"]; does: "The same, by hand"; }
                    }
                    Section {
                        title: "SIMULATOR";
                        horizontal-stretch: 1;
                        alignment: start;
                        Binding { keys: ["⌘", "S"]; does: "Save PNG"; }
                        Binding { keys: ["⌘", "R"]; does: "Reboot"; }
                        Binding { keys: ["⌘", "⇧", "R"]; does: "Reboot into debug"; }
                        Binding { keys: ["⌘", "⇧", "P"]; does: "Power off"; }
                        Binding { keys: ["⌘", "1"]; does: "microSD card in / out"; }
                        Binding { keys: ["⌘", "2"]; does: "USB disk in / out"; }
                        Binding { keys: ["⌘", "3"]; does: "USB DAC in / out"; }
                        Binding { keys: ["⌘", "4"]; does: "Charger on / off"; }
                        Binding { keys: ["⌘", "−"]; does: "Battery −5 %"; }
                        Binding { keys: ["⌘", "="]; does: "Battery +5 %"; }
                        Binding { keys: ["⌘", "\\"]; does: "Fold the sidebar"; }
                        Binding { keys: ["⌘", "K"]; does: "These bindings"; }
                    }
                }
            }
        }
    }
}
